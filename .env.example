# ==========================================
# 구독체크 서비스 환경 변수 템플릿 (.env.example)
# 이 파일을 .env.local 로 복사해 값을 채우세요. 실제 값은 커밋하지 마세요.
# ==========================================

# 1. 애플리케이션 기본 설정
# 로컬 개발은 http://localhost:3000 (Next.js가 127.0.0.1 리다이렉트를 localhost로 바꾸므로 맞춰 둠)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_TIMEZONE=Asia/Seoul

# 2. 데이터베이스 및 백엔드 스토리지 (공통 데이터 모델 및 인증 태스크 소유)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# DB 통합 테스트(npm run test:db) 대상. 비우면 로컬 Supabase(127.0.0.1:54322)를 사용하며 로컬 호스트만 허용됩니다.
TEST_DATABASE_URL=

# 3. 소셜 인증 OAuth (회원 인증 및 보안 세션 체계 구현 소유)
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 4. 웹 푸시 알림 VAPID 키 (웹 푸시 기반 결제 사전 알림 시스템 구축 소유)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 5. 스케줄러 배치 보안 시크릿 (웹 푸시 기반 결제 사전 알림 시스템 구축 소유)
# 크론이 POST/GET /api/v1/notifications/dispatch 를 Authorization: Bearer <CRON_SECRET> 로 호출 (예: 10분마다)
CRON_SECRET=

# 6. 로컬 검증 전용: 가짜 푸시 서버 주소 허용 (예: http://127.0.0.1:4010). 운영에서는 비워 두세요.
PUSH_TEST_ENDPOINT_ORIGIN=
